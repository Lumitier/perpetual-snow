{
  "schemaVersion": 1,
  "id": "perpetualsnow",
  "version": "${version}",
  "name": "Perpetual Snow",
  "description": "Client-side mod for permanent snowfall - independent of weather, biome and server. Works inside closed PvP arenas.",
  "authors": [
    "Lumitier"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/perpetual-snow",
    "sources": "https://github.com/Lumitier/perpetual-snow",
    "issues": "https://github.com/Lumitier/perpetual-snow/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/perpetualsnow/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.lumitier.perpetualsnow.client.PerpetualSnowClient"
    ],
    "modmenu": [
      "com.lumitier.perpetualsnow.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "perpetualsnow.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "yet_another_config_lib_v3": "*",
    "lumilib": ">=1.5.4"
  },
  "suggests": {
    "modmenu": "*"
  }
}
